# Example environment configuration for agent_debate.
#
# Copy this file to `.env` and fill in real values. `.env` is git-ignored and
# must never be committed. This template mirrors docs/PRD.md §7 "Configuration
# (env)"; keep the two in sync. All values below are SAFE PLACEHOLDERS — they
# are not real secrets.

# --- Provider credentials -----------------------------------------------------
# Anthropic API key (required). Get one at https://console.anthropic.com/.
# A real key looks like `sk-ant-...`; replace the placeholder below.
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# --- Models -------------------------------------------------------------------
# Models use the pydantic-ai `provider:model` form: the part before `:` selects
# the provider, the part after is the provider's raw model ID. Confirmed current
# Anthropic IDs (Claude 4.x family):
#   anthropic:claude-opus-4-8              -> Opus 4.8  (most capable; controller)
#   anthropic:claude-sonnet-4-6            -> Sonnet 4.6 (balanced; debaters)
#   anthropic:claude-haiku-4-5-20251001    -> Haiku 4.5 (fast/cheap alternative)
#
# Model used for both debaters. Sonnet 4.6 balances quality and cost; swap to
# `anthropic:claude-haiku-4-5-20251001` for cheaper, faster debates.
DEBATER_MODEL=anthropic:claude-sonnet-4-6
# Model used for the controller / judge. Opus 4.8 is the most capable model —
# preferred for the judging/orchestration role.
CONTROLLER_MODEL=anthropic:claude-opus-4-8
# Optional per-side overrides (enable cross-provider debates). Leave unset to
# fall back to DEBATER_MODEL for that side.
PRO_MODEL=
CON_MODEL=

# --- Debate parameters --------------------------------------------------------
# Number of rounds each agent gets.
ROUNDS=10
# Word limit per debate message.
MAX_WORDS=150
# Per-turn timeout, in seconds.
TURN_TIMEOUT_S=60
# Number of retries on a turn timeout/error.
MAX_RETRIES=2

# --- Budget -------------------------------------------------------------------
# Per-run USD budget cap. When a completed run's priced cost exceeds this cap an
# over-budget alert is logged (PRD §10). `0` (the default) means unlimited — no
# cap, no alert. Cost grows ~linearly in ROUNDS × MAX_WORDS (output) and faster
# in ROUNDS (replayed input context) — see PRD §10 "Cost vs. scale".
BUDGET_USD=0

# --- Search plug-in -----------------------------------------------------------
# Selects the SearchProvider plug-in: duckduckgo | tavily | bing | ...
SEARCH_BACKEND=duckduckgo
# API key for backends that require one (ignored by DuckDuckGo). Leave empty
# when using a keyless backend such as duckduckgo.
SEARCH_API_KEY=
